# Vite dev/prod envs — only VITE_-prefixed vars reach the browser bundle.
# Copy to `.env` and adjust. Never put secrets in this file.
#
# ---------------------------------------------------------------------------
# VITE_API_URL = the *origin* of the API. No trailing slash, NO "/api" suffix —
# src/api/axios.js appends "/api" itself. A "/api" suffix is stripped on read
# so an accidental copy cannot produce "/api/api/auth/login".
# ---------------------------------------------------------------------------
#
# Local development
#   VITE_API_URL=                        (empty)
#     -> baseURL "/api" (same origin) and vite.config.js proxies /api and
#        /uploads to http://localhost:5000. No CORS, cookies just work.
#     -> the backend MUST be running (`cd server && npm run dev`), otherwise the
#        dev proxy answers 502 for every request.
#   VITE_API_URL=http://localhost:5000    (explicit, identical result)
#
# Production (Vercel project environment variables, set before building)
#   VITE_API_URL=https://cv-analyzer-api.onrender.com
#     -> browser calls the API cross-origin, so the server needs
#        CLIENT_URL=<the Vercel URL>, COOKIE_SAMESITE=none, COOKIE_SECURE=true
#        (already set in server/render.yaml) and withCredentials: true
#        (already set in src/api/axios.js).
#   VITE_API_URL=                        (empty, only if the host proxies /api
#     -> for a same-origin deployment: keep it empty and add an
#        "/api/:path*" external rewrite to the backend in client/vercel.json.
#     A production build with this empty logs an error on startup.
VITE_API_URL=
VITE_API_TIMEOUT=60000

# Dev-only: where vite.config.js proxies /api and /uploads. Defaults to
# VITE_API_URL, or http://localhost:5000. Set it when the API runs somewhere
# else in development. Not needed in production (there is no dev server).
VITE_DEV_PROXY_TARGET=

# Upload + analysis only. A cold OCR cache makes the server boot Tesseract
# before it can read a scanned document, which has been measured at 117-146s, so
# this is much larger than the default timeout above. 240s clears the server's
# own 180s OCR init timeout with headroom.
VITE_ANALYSIS_TIMEOUT=240000
