# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
# REQUIRED. Use a dedicated least-privilege Atlas user, never an admin account.
# The URI that was previously hardcoded in server.js is compromised — rotate
# that password in MongoDB Atlas before using anything in production.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-cv-analyzer?retryWrites=true&w=majority

# ---------- Auth ----------
# REQUIRED. Must be at least 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- CORS / cookies ----------
# Origin of the React app. Change this in production to your deployed frontend.
CLIENT_URL=http://localhost:5173
# Comma separated. Only needed if you run more than one frontend.
ADDITIONAL_ORIGINS=
# "lax"  -> client and API served from the same site (single domain).
# "none" -> client and API on different sites (Vercel -> Render/Railway).
#           Requires COOKIE_SECURE=true, which is the default in production.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Set to false to stop serving /uploads statically (files then require auth).
# On platforms with an ephemeral filesystem you MUST use S3/Cloudinary instead
# of local disk — see the README deployment section.
PUBLIC_UPLOADS=true

# ---------- OCR (scanned / photographed CVs) ----------
# Set to false to reject .png/.jpg uploads entirely. Saves the ~15 MB Tesseract
# core, but users with a photo or scan of their CV can no longer upload it.
OCR_ENABLED=true
# Tesseract language. Multiple codes are joined with "+", e.g. eng+spa.
OCR_LANG=eng
# Where the ~15 MB eng.traineddata is cached. Gitignored.
OCR_CACHE_DIR=.ocr-cache
# On first image upload Tesseract downloads the language data from a CDN, so
# that request is slow and needs outbound network access. Set this to a local
# directory (or URL) containing <lang>.traineddata to run fully offline.
OCR_LANG_PATH=
# Budget for a single recognition. An A4 page takes ~2 s once the worker is up.
OCR_TIMEOUT_MS=30000
# Budget for booting the OCR worker. On a cold cache Tesseract downloads ~3 MB
# of language data, which can take minutes on a slow link; the first image
# upload pays this once, later ones reuse the cached worker. Raise it if your
# first upload fails with a timeout.
OCR_INIT_TIMEOUT_MS=180000
# How long OCR stays disabled after a failed boot.
OCR_RETRY_COOLDOWN_MS=300000
# Hard cap on an image, checked before OCR starts. Multer rejects anything
# above MAX_UPLOAD_MB first, so raise BOTH if you want to allow big photos.
OCR_MAX_IMAGE_MB=5

# ---------- AI provider ----------
# auto  = use the first configured key, in the order groq -> openai -> xai
# local = always use the built-in deterministic engine (free, offline, no key)
# Set explicitly to groq | openai | xai | local to pin one provider.
AI_PROVIDER=auto

# All keys are OPTIONAL. With none set, the app runs fully on the local engine.
# Pick one provider; Groq is free with a generous rate limit.

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7
